# Image phụ CHỈ để chạy bước "answer" cho vinai/PhoGPT-4B-Chat.
# PhoGPT mang code kiến trúc MPT riêng (trust_remote_code). Code này import lớp RoPE của Llama đã bị xoá
# khỏi transformers bản mới và cần generate() kiểu cũ, nên ghim transformers 4.44.
# Hai lớp đầu giống Dockerfile.llm5 -> Docker dùng lại cache torch, không tải lại.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/root/.cache/huggingface \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install "torch==2.8.0" --index-url https://download.pytorch.org/whl/cu128
RUN pip install "transformers==4.44.2" "accelerate==0.34.2" "bitsandbytes>=0.46.1" "jinja2>=3.1.0" \
                einops sentencepiece protobuf "numpy>=1.26,<2.3"

COPY src ./src

ENTRYPOINT ["python", "-m", "text_summarization"]
CMD ["answer", "--llm", "phogpt-4b-chat", "--llm-4bit"]
